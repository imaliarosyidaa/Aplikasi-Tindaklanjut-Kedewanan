generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  user
}

model Role {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @unique
  description String        @default("")
  permissions RolePermission[]
  users       User[]        @relation("UserRoleRef")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique
  resource    String           @default("")
  action      String           @default("")
  description String           @default("")
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("permissions")
}

model RolePermission {
  roleId       String      @map("role_id") @db.Uuid
  permissionId String      @map("permission_id") @db.Uuid
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum AspirasiStatus {
  BELUM_DITINDAKLANJUTI
  SEDANG_DITINDAKLANJUTI
  SUDAH_DITINDAKLANJUTI
  TIDAK_BISA_DITINDAKLANJUTI
}

model User {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username  String     @unique
  email     String?    @unique
  password  String
  name      String
  role      UserRole
  role_id   String?    @map("role_id") @db.Uuid
  roleRef   Role?      @relation("UserRoleRef", fields: [role_id], references: [id])
  aspirasis Aspirasis[]
  kegiatans Kegiatan[]
  trackings TrackingAspirasi[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

model Kota {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama       String      @unique
  kecamatans Kecamatan[]
  kelurahans Kelurahan[]
  kunjungans Kunjungan[]
  relawans Relawan[]
  aspirasis Aspirasis[]

  @@map("kotas")
}

model Kecamatan {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kota_id    String      @db.Uuid
  nama       String      @unique
  kelurahans Kelurahan[]
  kunjungans Kunjungan[]
  kota       Kota        @relation(fields: [kota_id], references: [id])
  relawans Relawan[]
  aspirasis Aspirasis[]

  @@map("kecamatans")
}

model Kelurahan {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kecamatan_id String   @db.Uuid
  nama         String
  kecamatan    Kecamatan   @relation(fields: [kecamatan_id], references: [id])
  kunjungans   Kunjungan[]
  relawans Relawan[]
  aspirasis Aspirasis[]
  kotas Kota[]

  @@map("kelurahans")
}

model Kunjungan {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tanggal        DateTime
  jam            String
  jalan          String
  kelurahan_id   String  @db.Uuid
  kecamatan_id   String  @db.Uuid
  kota_id        String  @db.Uuid
  link_gmaps     String?    @default("")
  kelurahan    Kelurahan @relation(fields: [kelurahan_id], references: [id])
  kecamatan    Kecamatan @relation(fields: [kecamatan_id], references: [id])
  kota         Kota        @relation(fields: [kota_id], references: [id])
  kegiatans    Kegiatan[]
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@map("kunjungans")
}

model Aspirasis {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_laporan           String?         @default("")
  nik                  String?          @default("")
  sumber               String
  deskripsi            String
  status               AspirasiStatus
  pelapor_nama         String
  pelapor_email        String?    @default("")
  pelapor_telepon      String
  lampiran             Json?            @default("[]")
  kategori_usulan      String
  jenis_usulan         String
  jenis_reses          String
  tindak_lanjut        String
  tanggal_dibuat       DateTime
  kota_id              String?         @db.Uuid
  kecamatan_id         String?         @db.Uuid
  kelurahan_id         String?         @db.Uuid
  alamat               String?
  user_id              String?         @db.Uuid
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  user                 User?           @relation(fields: [user_id], references: [id])
  kota                 Kota?           @relation(fields: [kota_id], references: [id])
  kecamatan            Kecamatan?      @relation(fields: [kecamatan_id], references: [id])
  kelurahan            Kelurahan?      @relation(fields: [kelurahan_id], references: [id])
  trackings            TrackingAspirasi[]
  @@map("aspirasis")
}

model TrackingAspirasi {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aspirasi_id    String         @db.Uuid
  status         AspirasiStatus
  catatan        String?
  lampiran       Json?          @default("[]")
  created_at     DateTime       @default(now())

  aspirasi       Aspirasis      @relation(fields: [aspirasi_id], references: [id], onDelete: Cascade)
  diverifikasi_oleh_id String?  @db.Uuid
  diverifikasiOleh     User?    @relation(fields: [diverifikasi_oleh_id], references: [id])
  @@map("tracking_aspirasis")
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

enum PosisiRelawan {
  KOORDINATOR_RW
  KOORDINATOR_RT
  KOORDINATOR_KELURAHAN
  KOORDINATOR_KECAMATAN
  FKDM
  LMK
  TOKOH_MASYARAKAT
  PROFESIONAL
}

model Relawan {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nik            String?        @unique
  nama           String
  no_telepon     String?
  jenis_kelamin  JenisKelamin
  alamat         String
  posisi         PosisiRelawan
  foto           String?
  created_at     DateTime      @default(now()) @map("created_at")
  updated_at     DateTime      @updatedAt @map("updated_at")
  kota_id        String  @db.Uuid
  kecamatan_id   String  @db.Uuid
  kelurahan_id   String  @db.Uuid

  kota           Kota        @relation(fields: [kota_id], references: [id])
  kecamatan      Kecamatan   @relation(fields: [kecamatan_id], references: [id])
  kelurahan      Kelurahan   @relation(fields: [kelurahan_id], references: [id])
  @@map("relawans")
}

model Kegiatan {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jenis_kegiatan String    @default("")
  kunjungan_id   String  @db.Uuid
  isi            String?
  hari           String?
  tanggal        DateTime?
  foto           String?
  nama_kegiatan  String
  link_gmaps     String?
  tempat         String?
  alamat         String?
  rt             String?
  rw             String?
  jumlah_peserta Int?
  catatan        String?
  dibuat_oleh_id String?  @db.Uuid
  kunjungan      Kunjungan @relation(fields: [kunjungan_id], references: [id])
  dibuatOleh     User?    @relation(fields: [dibuat_oleh_id], references: [id])

  @@map("kegiatans")
}