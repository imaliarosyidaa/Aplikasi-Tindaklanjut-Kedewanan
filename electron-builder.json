{
  "appId": "com.dprd-jaksel.kunjungan-tracker",
  "productName": "Aplikasi Koordinasi Tindak Lanjut Kedewanan",
  "asar": true,
  "asarUnpack": [
    "**/node_modules/@prisma/client/**",
    "**/node_modules/@prisma/client-runtime-utils/**",
    "**/node_modules/prisma/**",
    "**/node_modules/.prisma/**",
    "**/node_modules/@prisma/adapter-mariadb/**"
  ],
  "extraResources": [
    {
      "from": "./node_modules/.prisma",
      "to": "../.prisma/"
    },
    {
      "from": "./node_modules/@prisma/client",
      "to": "../@prisma/client"
    },
    {
      "from": "./node_modules/@prisma/client-runtime-utils",
      "to": "../@prisma/client-runtime-utils"
    },
    {
      "from": "./node_modules/@prisma/adapter-mariadb",
      "to": "../@prisma/adapter-mariadb"
    }
  ],
  "directories": {
    "output": "release"
  },
  "files": [
    ".env",
    "prisma.config.ts",
    "electron/**/*",
    ".next/**/*",
    "public/**/*",
    "next.config.ts",
    "package.json",
    "prisma/**/*",
    "src/generated/**/*",
    "node_modules/**/*",
    "!node_modules/.cache",
    "!**/*.map",
    "!**/CHANGELOG*",
    "!**/README*",
    "!.next/dev/**/*"
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/Lambang_DPRD_Generik.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Aplikasi Koordinasi Tindak Lanjut Kedewanan"
  }
}
